# Four runs a day, off the hour, with jitter. Persistent=true catches up after
# the machine was asleep, so a laptop does not silently stop updating.
[Unit]
Description=Harvest GPU prices four times a day

[Timer]
OnCalendar=*-*-* 00/6:07:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target

# The same timer file works for both installs: as a user unit from
# ~/.config/systemd/user/, or as a system unit in /etc/systemd/system/.
