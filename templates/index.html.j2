{% extends "base.html.j2" %}
{% block ogtitle %}Komper — wydajność na złotówkę: ranking kart graficznych{% endblock %}
{% block title %}Komper — które GPU daje najwięcej wydajności za złotówkę{% endblock %}
{% block content %}
<h1>Wydajność na złotówkę</h1>
<p class="lede">
  Ranking kart graficznych dostępnych teraz w polskich sklepach.
  Liczy się jedna rzecz: ile wydajności dostajesz za swoje pieniądze.
</p>
<section class="picks">
  <h2>Co kupić</h2>
  <div class="pick-grid">
  {% for pick in picks %}
    <a class="pick" href="/gpu/{{ pick.chip.key }}">
      <span class="pick-label">{{ pick.label }}</span>
      <span class="pick-name">{{ pick.chip.chip }} <span class="muted">{{ pick.chip.vram_gb|int }} GB</span></span>
      <span class="pick-price">{{ pick.chip.stats.p_buy|money }}</span>
      <span class="pick-value">{{ pick.chip.value }} pkt / 1000 zł</span>
    </a>
  {% endfor %}
  </div>
  <p class="muted">Najwyższa wartość w danym przedziale cenowym, bez względu na klasę karty.</p>
</section>

<p class="stamp">Ceny sprawdzone: {{ scraped }}</p>

<div class="notice">
  <strong>Wydajność to proxy, nie pomiar FPS.</strong> Liczona ze specyfikacji
  i kalibrowana współczynnikiem architektury — służy do porównania kart
  <em>między sobą</em>. <a href="/metodologia/">Jak to liczymy</a>.
</div>

<div class="sortbar">
  <label>Sortuj:
    <select id="sort">
      <option value="value:desc" selected>Punkty / 1000 zł — najwyżej</option>
      <option value="price:asc">Cena — od najniższej</option>
      <option value="price:desc">Cena — od najwyższej</option>
      <option value="perf:desc">Wydajność — od najwyższej</option>
      <option value="perf:asc">Wydajność — od najniższej</option>
      <option value="name:asc">Nazwa</option>
    </select>
  </label>
</div>

<table class="ranking">
  <thead>
    <tr>
      <th>#</th>
      <th><button class="sort" data-sort="name" data-first="asc">Karta</button></th>
      <th class="num"><button class="sort" data-sort="perf" data-first="desc">Wydajność</button></th>
      <th class="num"><button class="sort" data-sort="price" data-first="asc">Cena</button></th>
      <th class="num"><button class="sort" data-sort="value" data-first="desc">Pkt / 1000 zł</button></th>
      <th class="num"><button class="sort" data-sort="offers" data-first="desc">Ofert</button></th>
      <th class="num"><button class="sort" data-sort="stores" data-first="desc">Sklepy</button></th>
    </tr>
  </thead>
  <tbody>
  {% for chip in rows %}
    <tr{% if loop.first %} class="top"{% endif %}>
      <td class="rank" data-label="Miejsce">{{ loop.index }}</td>
      <td data-label="Karta" data-sort="name" data-value="{{ chip.chip }} {{ chip.vram_gb|int }}"><a href="/gpu/{{ chip.key }}">{{ chip.chip }}</a>
          <span class="muted">{{ chip.vram_gb|int }} GB</span>
          <span class="tag">{{ chip.target }}</span></td>
      <td class="num" data-label="Wydajność" data-sort="perf" data-value="{{ chip.perf }}"><span class="bar"><span style="width:{{ chip.perf }}%"></span></span> {{ chip.perf }}</td>
      <td class="num" data-label="Cena" data-sort="price" data-value="{{ chip.stats.p_buy }}">{{ chip.stats.p_buy|money }}</td>
      <td class="num strong" data-label="Pkt / 1000 zł" data-sort="value" data-value="{{ chip.value }}"><span class="bar bar-value"><span style="width:{{ chip.value_pct }}%"></span></span> {{ chip.value }}</td>
      <td class="num" data-label="Ofert" data-sort="offers" data-value="{{ chip.stats.offers }}">{{ chip.stats.offers }}</td>
      <td class="num" data-label="Sklepy" data-sort="stores" data-value="{{ chip.stats.stores }}">{{ chip.stats.stores }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<p class="legend">
  <strong>Pkt / 1000 zł</strong> — wydajność dzielona przez najtańszą cenę.
  Kliknij nagłówek, żeby posortować. <strong>#</strong> to miejsce w rankingu
  wartości — sortowanie zmienia kolejność wierszy, nie ten numer.
</p>

{% if unpriced %}
<p class="muted">
  Bez ceny w tej chwili (nie rankowane): {{ unpriced|join(", ") }}.
</p>
{% endif %}
{% if low_vram %}
<p class="muted">
  Nie rozważamy — mniej niż {{ min_vram }} GB pamięci, za mało na współczesne
  tekstury w 1080p: {{ low_vram|join(", ") }}.
</p>
{% endif %}
{% if old_gen %}
<p class="muted">
  Nie rozważamy — architektura starsza niż {{ min_arch_year }} (RTX 30 / RX 6000
  i nowsze): {{ old_gen|join(", ") }}.
</p>
{% endif %}
{% if single %}
<p class="muted">
  Nie rankowane — tylko jedna oferta w sklepie, więc cena nie jest rynkowa:
  {{ single|join(", ") }}.
</p>
{% endif %}
{% if incomplete %}
<p class="muted">
  Pominięte z braku pełnej specyfikacji: {{ incomplete|join(", ") }}.
  Karta jest liczona tylko wtedy, gdy wszystkie wejścia modelu są znane.
</p>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
(function () {
  var table = document.querySelector('.ranking');
  if (!table || !table.tBodies.length) return;
  var tbody = table.tBodies[0];
  var rows = Array.prototype.slice.call(tbody.rows);
  var headers = Array.prototype.slice.call(table.querySelectorAll('button.sort'));
  var select = document.getElementById('sort');

  function sortBy(key, ascending) {
    var sorted = rows.slice().sort(function (a, b) {
      var ca = a.querySelector('[data-sort="' + key + '"]');
      var cb = b.querySelector('[data-sort="' + key + '"]');
      var av = ca ? ca.getAttribute('data-value') : '';
      var bv = cb ? cb.getAttribute('data-value') : '';
      var an = parseFloat(av), bn = parseFloat(bv);
      if (!isNaN(an) && !isNaN(bn)) return ascending ? an - bn : bn - an;
      return (ascending ? 1 : -1) * String(av).localeCompare(String(bv), 'pl');
    });
    sorted.forEach(function (row) { tbody.appendChild(row); });
    headers.forEach(function (h) {
      if (h.getAttribute('data-sort') === key) h.setAttribute('data-dir', ascending ? 'asc' : 'desc');
      else h.removeAttribute('data-dir');
    });
    if (select) {
      var wanted = key + ':' + (ascending ? 'asc' : 'desc');
      var exists = Array.prototype.some.call(select.options, function (o) { return o.value === wanted; });
      if (exists) select.value = wanted;
    }
  }

  headers.forEach(function (h) {
    h.addEventListener('click', function () {
      var key = h.getAttribute('data-sort');
      var current = h.getAttribute('data-dir');
      var first = h.getAttribute('data-first') || 'desc';
      // first click uses the column's natural direction, then toggles
      var ascending = current ? current !== 'asc' : first === 'asc';
      sortBy(key, ascending);
    });
  });

  if (select) {
    select.addEventListener('change', function () {
      var parts = select.value.split(':');
      sortBy(parts[0], parts[1] === 'asc');
    });
  }
})();
</script>
{% endblock %}
